{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manythreads.kahf.to/schemas/journeys-manifest.json",
  "title": "Persona journey manifest",
  "description": "docs/journeys/<persona>/manifest.<desktop|mobile>.json: one entry per picture a persona run took (written by e2e/personas/harness/shot.ts). results.<desktop|mobile>.json next to it holds one entry per journey.",
  "type": "array",
  "items": { "$ref": "#/$defs/entry" },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persona", "journey", "step", "kind", "viewport", "url", "landmark", "number", "file", "sha256", "bytes", "time"],
      "properties": {
        "persona": { "enum": ["omar", "nadia", "rafi", "sameera", "tariq", "priya", "lena"] },
        "journey": { "type": "string", "pattern": "^[A-Z]+[0-9]+$", "description": "The journey id, such as N2." },
        "step": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "kind": { "enum": ["desktop", "mobile", "native"] },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }
        },
        "url": { "type": "string", "description": "Path and query on the stack, without the origin." },
        "landmark": { "type": "string", "description": "The data-landmark or data-testid that was checked before the picture." },
        "number": { "type": "integer", "minimum": 1, "description": "Persona-wide running number of the step; the same on every viewport." },
        "file": { "type": "string", "pattern": "^[a-z]+/(mobile/)?[0-9]{2,}-[A-Z]+[0-9]+-[a-z0-9-]+\\.png$", "description": "Path below docs/journeys." },
        "sha256": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 1 },
        "time": { "type": "string", "format": "date-time" }
      }
    }
  }
}
