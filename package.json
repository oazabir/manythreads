{
  "name": "majlis",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "lint": "eslint . && stylelint \"**/*.css\"",
    "typecheck": "pnpm -r --parallel typecheck",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:rls": "vitest run --project rls",
    "test:events": "vitest run --project events",
    "test:schema-compat": "vitest run --project schema-compat",
    "db:up": "docker compose -f deploy/compose/docker-compose.dev.yml up -d --wait postgres",
    "db:down": "docker compose -f deploy/compose/docker-compose.dev.yml down",
    "e2e": "pnpm -C e2e exec playwright test -c playwright.config.ts",
    "vt": "tsx tools/plates/src/cli.ts",
    "vt:update": "tsx tools/plates/src/cli.ts --update"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^16",
    "stylelint": "^16",
    "stylelint-config-standard": "^39",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3"
  }
}
