        "app.kubernetes.io/component": "claude-pod",
        "app.kubernetes.io/managed-by": "manythreads-claude-pods",
        "manythreads.io/runner": "team-codex",
        "manythreads.io/runner-id": "00000000-0000-4000-8000-teamcodex000"
      }
    },
    "spec": {
      "selector": {
        "manythreads.io/pod": "codex-team-codex"
      },
      "ports": [
        {
          "name": "bridge",
          "port": 8650,
          "targetPort": 8650
        }
      ]
    }
  },
  {
    "apiVersion": "v1",
    "kind": "ServiceAccount",
    "metadata": {
      "name": "codex-team-codex-keeper",
      "namespace": "bots",
      "labels": {
        "app.kubernetes.io/name": "manythreads",
        "app.kubernetes.io/component": "claude-pod",
        "app.kubernetes.io/managed-by": "manythreads-claude-pods",
        "manythreads.io/runner": "team-codex",
