        "app.kubernetes.io/managed-by": "manythreads-claude-pods",
        "manythreads.io/runner": "team-codex",
        "manythreads.io/runner-id": "00000000-0000-4000-8000-teamcodex000"
      }
    },
    "rules": [
      {
        "apiGroups": [
          ""
        ],
        "resources": [
          "secrets"
        ],
        "resourceNames": [
          "codex-team-codex-credentials"
        ],
        "verbs": [
