{
  "name": "@manythreads/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The program that runs a team's agents on a machine outside the cluster (SPEC §7.4, PLAN P6-06).",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "manythreads-runner": "./src/main.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@manythreads/sdk": "workspace:*",
    "@manythreads/shared": "workspace:*",
    "tsx": "^4",
    "ws": "^8",
    "yaml": "^2.9.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "^8"
  }
}
