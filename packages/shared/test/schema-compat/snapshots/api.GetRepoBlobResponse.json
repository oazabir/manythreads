{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ref": {
      "type": "string"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "path": {
      "type": "string"
    },
    "blobSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "encoding": {
      "type": "string",
      "enum": [
        "utf8",
        "base64"
      ]
    },
    "content": {
      "type": "string"
    }
  },
  "required": [
    "ref",
    "commitSha",
    "path",
    "blobSha",
    "size",
    "encoding",
    "content"
  ]
}
