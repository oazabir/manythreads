{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "botSlug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    }
  },
  "required": [
    "slug",
    "botSlug"
  ]
}
