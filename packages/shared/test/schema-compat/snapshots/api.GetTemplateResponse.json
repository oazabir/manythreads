{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "template": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,39}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "channels": {
          "minItems": 1,
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^#[a-z0-9][a-z0-9-]{0,62}$"
              },
              "private": {
                "type": "boolean"
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 250
              }
            },
            "required": [
              "name",
              "purpose"
            ],
            "additionalProperties": false
          }
        },
        "board": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "columns": {
              "minItems": 1,
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            }
          },
          "required": [
            "name",
            "columns"
          ],
          "additionalProperties": false
        },
        "bots": {
          "minItems": 1,
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,39}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "automation": {
                "type": "boolean"
              }
            },
            "required": [
              "slug",
              "name",
              "role"
            ],
            "additionalProperties": false
          }
        },
        "roleTags": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^role:[a-z][a-z0-9-]*$"
          }
        },
        "teamMd": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "version",
        "channels",
        "board",
        "bots",
        "roleTags",
        "teamMd"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "template"
  ]
}
