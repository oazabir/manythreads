{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "endpoint": {
      "type": "string",
      "minLength": 12,
      "maxLength": 2048
    },
    "keys": {
      "type": "object",
      "properties": {
        "p256dh": {
          "type": "string",
          "minLength": 40,
          "maxLength": 200
        },
        "auth": {
          "type": "string",
          "minLength": 10,
          "maxLength": 100
        }
      },
      "required": [
        "p256dh",
        "auth"
      ],
      "additionalProperties": false
    },
    "label": {
      "type": "string",
      "maxLength": 80
    }
  },
  "required": [
    "endpoint",
    "keys"
  ],
  "additionalProperties": false
}
