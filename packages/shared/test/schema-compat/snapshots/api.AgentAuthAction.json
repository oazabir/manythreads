{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "enter_code"
        },
        "url": {
          "type": "string",
          "pattern": "^https:\\/\\/[^\\s\"'<>]{1,500}$"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{3,20}$"
        }
      },
      "required": [
        "type",
        "url",
        "code"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "open_url"
        },
        "url": {
          "type": "string",
          "pattern": "^https:\\/\\/[^\\s\"'<>]{1,500}$"
        }
      },
      "required": [
        "type",
        "url"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "paste_code"
        },
        "url": {
          "type": "string",
          "pattern": "^https:\\/\\/[^\\s\"'<>]{1,500}$"
        }
      },
      "required": [
        "type",
        "url"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "give_key"
        }
      },
      "required": [
        "type"
      ]
    }
  ]
}
