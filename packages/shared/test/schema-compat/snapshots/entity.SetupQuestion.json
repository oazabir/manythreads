{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^q[0-9]{1,3}$"
    },
    "requirementId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
    },
    "question": {
      "type": "string",
      "maxLength": 400
    },
    "options": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80
      }
    }
  },
  "required": [
    "id",
    "requirementId",
    "question",
    "options"
  ],
  "additionalProperties": false
}
