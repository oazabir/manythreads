{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ask": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "answerer": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "brain",
                    "notetaker"
                  ]
                },
                "name": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "kind",
                "name"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "available",
        "answerer",
        "reason"
      ]
    },
    "catchUp": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "minutesBefore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "available",
        "minutesBefore",
        "reason"
      ]
    }
  },
  "required": [
    "ask",
    "catchUp"
  ]
}
