{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "meetingId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "on_device",
        "server",
        "off"
      ]
    },
    "turnedOnBy": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "actorId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "displayName": {
              "type": "string"
            }
          },
          "required": [
            "actorId",
            "displayName"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "allowed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "on_device",
          "server"
        ]
      }
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "meetingId",
    "mode",
    "turnedOnBy",
    "allowed",
    "reason"
  ]
}
