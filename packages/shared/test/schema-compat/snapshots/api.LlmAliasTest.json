{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "alias": {
      "type": "string",
      "enum": [
        "smart",
        "fast",
        "code",
        "local",
        "embed",
        "vision",
        "image",
        "transcribe"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "ok",
        "failed"
      ]
    },
    "cause": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "no_gateway",
            "unbound",
            "refused",
            "auth",
            "model_not_found",
            "rate_limited",
            "provider_error",
            "timeout",
            "unreachable",
            "empty_answer",
            "other"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "latencyMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "testedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "testedBy": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "current": {
      "type": "boolean"
    }
  },
  "required": [
    "alias",
    "outcome",
    "cause",
    "message",
    "model",
    "latencyMs",
    "testedAt",
    "testedBy",
    "current"
  ]
}
