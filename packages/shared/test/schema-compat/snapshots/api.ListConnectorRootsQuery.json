{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "notion",
        "confluence",
        "google_drive",
        "sharepoint",
        "onedrive",
        "dropbox",
        "box"
      ]
    },
    "parent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  },
  "required": [
    "provider"
  ]
}
