{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "alias": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "hint": {
      "type": "string",
      "maxLength": 120
    },
    "available": {
      "type": "boolean"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "isDefault": {
      "type": "boolean"
    }
  },
  "required": [
    "alias",
    "label",
    "hint",
    "available",
    "reason",
    "isDefault"
  ]
}
