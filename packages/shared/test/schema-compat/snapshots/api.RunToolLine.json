{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "tool"
    },
    "stepId": {
      "type": "string",
      "maxLength": 200
    },
    "parentStepId": {
      "type": "string",
      "maxLength": 200
    },
    "stepKind": {
      "type": "string",
      "enum": [
        "read",
        "edit",
        "delete",
        "move",
        "search",
        "execute",
        "think",
        "fetch",
        "switch_mode",
        "other"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 400
    },
    "paths": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      }
    }
  },
  "required": [
    "kind",
    "stepId",
    "stepKind"
  ]
}
