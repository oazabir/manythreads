{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "removed": {
      "type": "boolean"
    },
    "reactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "emoji": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^\\S+$"
          },
          "count": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "mine": {
            "type": "boolean"
          }
        },
        "required": [
          "emoji",
          "count",
          "mine"
        ]
      }
    }
  },
  "required": [
    "removed",
    "reactions"
  ]
}
