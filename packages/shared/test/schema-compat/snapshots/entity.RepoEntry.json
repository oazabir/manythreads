{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "teamId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "file"
      ]
    },
    "blobSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lastCommitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "textPlain": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "teamId",
    "path",
    "kind",
    "blobSha",
    "size",
    "lastCommitSha",
    "textPlain"
  ],
  "additionalProperties": false
}
