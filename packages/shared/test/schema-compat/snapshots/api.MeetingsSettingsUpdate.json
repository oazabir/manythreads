{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "transcribeCap": {
      "type": "string",
      "enum": [
        "on_device",
        "server",
        "off"
      ]
    },
    "roomCap": {
      "type": "integer",
      "minimum": 2,
      "maximum": 100
    },
    "recordingCap": {
      "type": "string",
      "enum": [
        "off",
        "on"
      ]
    },
    "notetakerAllowed": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
