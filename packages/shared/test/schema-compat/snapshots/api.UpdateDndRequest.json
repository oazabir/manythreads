{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "pauseMinutes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 10080
        },
        {
          "type": "null"
        }
      ]
    },
    "schedule": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "windows": {
          "maxItems": 7,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "days": {
                "minItems": 1,
                "maxItems": 7,
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                }
              },
              "start": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "end": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              }
            },
            "required": [
              "days",
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "enabled",
        "windows"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
