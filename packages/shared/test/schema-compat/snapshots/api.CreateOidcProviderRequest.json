{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "google"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "clientSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "allowedDomains": {
          "minItems": 1,
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
          }
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "clientId",
        "clientSecret",
        "allowedDomains"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "microsoft"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "clientSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "allowedDomains": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
          }
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "tenantId",
        "clientId",
        "clientSecret"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "oidc"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "issuer": {
          "type": "string",
          "maxLength": 2048,
          "format": "uri"
        },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "clientSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "allowedDomains": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
          }
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "issuer",
        "clientId",
        "clientSecret"
      ],
      "additionalProperties": false
    }
  ]
}
