{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "teamId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "teamSlug": {
      "type": "string"
    },
    "teamName": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "external",
        "managed"
      ]
    },
    "agent": {
      "type": "string",
      "enum": [
        "hermes",
        "claude-code",
        "codex"
      ]
    },
    "baseUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "adoptable": {
      "type": "boolean"
    },
    "adoptableReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "botCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "teamId",
    "teamSlug",
    "teamName",
    "name",
    "kind",
    "agent",
    "baseUrl",
    "adoptable",
    "adoptableReason",
    "botCount"
  ],
  "additionalProperties": false
}
