{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "inputSchema": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "destructive": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "description",
    "inputSchema",
    "destructive"
  ],
  "additionalProperties": false
}
