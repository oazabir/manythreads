{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "verify",
        "waiting_on_person",
        "done"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    }
  },
  "required": [
    "state",
    "title"
  ],
  "additionalProperties": false
}
