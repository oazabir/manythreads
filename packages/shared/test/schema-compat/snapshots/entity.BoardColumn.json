{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,40}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "state": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "verify",
        "waiting_on_person",
        "done"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    }
  },
  "required": [
    "id",
    "name",
    "state",
    "title"
  ],
  "additionalProperties": false
}
