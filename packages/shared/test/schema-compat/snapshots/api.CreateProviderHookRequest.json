{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "github",
        "gitlab",
        "jira",
        "linear",
        "zendesk",
        "intercom",
        "hubspot",
        "asana",
        "generic"
      ]
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "eventFilter": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_]*(\\.([a-z][a-z0-9_]*|\\*)){0,3}$"
      }
    },
    "signingSecret": {
      "type": "string",
      "minLength": 8,
      "maxLength": 500
    }
  },
  "required": [
    "provider",
    "slug"
  ],
  "additionalProperties": false
}
