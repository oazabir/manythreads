{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 220
    },
    "category": {
      "type": "string",
      "enum": [
        "requests",
        "rhythm",
        "customers",
        "engineering",
        "people",
        "content"
      ]
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "schedule": {
      "type": "object",
      "properties": {
        "cron": {
          "type": "string",
          "pattern": "^\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s+\\S+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "cron",
        "label"
      ],
      "additionalProperties": false
    },
    "channels": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^#[a-z0-9][a-z0-9-]{0,62}$"
      }
    },
    "needs": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "botSlug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(bots\\/[a-z][a-z0-9-]{0,39}\\/(BOT\\.md|evals\\/[a-z0-9][a-z0-9._-]{0,63}\\.yaml)|routines\\/[a-z][a-z0-9-]{0,39}\\.yaml)$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 65536
      }
    }
  },
  "required": [
    "id",
    "name",
    "summary",
    "category",
    "version",
    "schedule",
    "channels",
    "needs",
    "botSlug",
    "files"
  ],
  "additionalProperties": false
}
