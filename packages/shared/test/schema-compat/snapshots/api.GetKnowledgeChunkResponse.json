{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hit": {
      "type": "object",
      "properties": {
        "chunkId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "baseSlug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "documentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "documentName": {
          "type": "string"
        },
        "documentKind": {
          "type": "string",
          "enum": [
            "markdown",
            "text",
            "csv",
            "pdf"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "currentVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sourceChanged": {
          "type": "boolean"
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "offsetStart": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "offsetEnd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "repoPath": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "chunkId",
        "baseSlug",
        "documentId",
        "documentName",
        "documentKind",
        "version",
        "currentVersion",
        "sourceChanged",
        "section",
        "offsetStart",
        "offsetEnd",
        "text",
        "score",
        "repoPath"
      ]
    }
  },
  "required": [
    "hit"
  ]
}
