{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "conflict"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "conflicts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "enum": [
              "changed",
              "exists",
              "missing",
              "folder",
              "parent_is_file"
            ]
          },
          "currentBlobSha": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "currentSize": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "currentContent": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "path",
          "reason",
          "currentBlobSha",
          "currentSize",
          "currentContent"
        ]
      }
    }
  },
  "required": [
    "error",
    "conflicts"
  ]
}
