{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "remove": {
      "default": [],
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 40
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "digest"
  ],
  "additionalProperties": false
}
