{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "delayMinutes": {
      "type": "integer",
      "minimum": 30,
      "maximum": 1440
    },
    "emailAvailable": {
      "type": "boolean"
    },
    "mailConfigured": {
      "type": "boolean"
    },
    "lastSentAt": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "enabled",
    "delayMinutes",
    "emailAvailable",
    "mailConfigured",
    "lastSentAt"
  ],
  "additionalProperties": false
}
