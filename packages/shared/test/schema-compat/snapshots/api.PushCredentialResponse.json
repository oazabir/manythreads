{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,60}$"
    },
    "origin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "provider": {
      "type": "string",
      "enum": [
        "github",
        "gitlab"
      ]
    },
    "login": {
      "type": "string",
      "maxLength": 255
    },
    "userId": {
      "type": "string",
      "maxLength": 20
    },
    "commitAs": {
      "type": "string",
      "enum": [
        "bot",
        "requester"
      ]
    },
    "refused": {
      "type": "boolean"
    }
  },
  "required": [
    "project",
    "origin",
    "branch",
    "token"
  ]
}
