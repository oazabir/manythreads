{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "bots": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    },
    "cardRef": {
      "type": "string",
      "enum": [
        "plan",
        "work",
        "publish"
      ]
    },
    "done": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    }
  },
  "required": [
    "title",
    "bots",
    "done"
  ],
  "additionalProperties": false
}
