{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "ready"
        },
        "limits": {
          "type": "object",
          "properties": {
            "idleSeconds": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxSeconds": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "outputBytesPerSecond": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "outputBytesTotal": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "inputBytesTotal": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "transcriptChars": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "idleSeconds",
            "maxSeconds",
            "outputBytesPerSecond",
            "outputBytesTotal",
            "inputBytesTotal",
            "transcriptChars"
          ],
          "additionalProperties": false
        },
        "credentialsRevoked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "t",
        "limits",
        "credentialsRevoked"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "out"
        },
        "d": {
          "type": "string"
        }
      },
      "required": [
        "t",
        "d"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "type": "string",
          "const": "end"
        },
        "reason": {
          "type": "string",
          "enum": [
            "closed",
            "ended_by_admin",
            "idle",
            "max_duration",
            "output_limit",
            "input_limit",
            "session_ended",
            "server_stop",
            "unused",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [
        "t",
        "reason",
        "message"
      ],
      "additionalProperties": false
    }
  ]
}
