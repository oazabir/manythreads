{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspaceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "email": {
      "type": "string",
      "maxLength": 320
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    }
  },
  "required": [
    "workspaceName",
    "name",
    "email",
    "password"
  ],
  "additionalProperties": false
}
