{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mail": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "connectionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "threadKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^[\\x21-\\x7e]+$"
        },
        "messageRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^[\\x21-\\x7e]+$"
        },
        "duplicate": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "connectionId",
        "threadKey",
        "messageRef",
        "duplicate"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "mail"
  ],
  "additionalProperties": false
}
