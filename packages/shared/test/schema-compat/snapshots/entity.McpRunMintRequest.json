{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pairingToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "trigger": {
      "type": "string",
      "enum": [
        "conversation",
        "mention",
        "routine",
        "task_assigned",
        "inbox",
        "channel_message",
        "webhook"
      ]
    },
    "askerActorId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "threadId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "ttlSeconds": {
      "default": 900,
      "type": "integer",
      "minimum": 30,
      "maximum": 3600
    }
  },
  "required": [
    "pairingToken",
    "trigger",
    "ttlSeconds"
  ],
  "additionalProperties": false
}
