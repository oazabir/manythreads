{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "teamId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "path": {
      "type": "string"
    },
    "op": {
      "type": "string",
      "enum": [
        "put",
        "delete"
      ]
    },
    "title": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "applied",
        "rejected",
        "withdrawn"
      ]
    },
    "authorId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "authorKind": {
      "type": "string",
      "enum": [
        "person",
        "bot"
      ]
    },
    "authorName": {
      "type": "string"
    },
    "baseBlobSha": {
      "type": [
        "string",
        "null"
      ]
    },
    "baseCommitSha": {
      "type": "string"
    },
    "diff": {
      "type": "string"
    },
    "added": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "removed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "maxLength": 1200
          }
        },
        "required": [
          "name",
          "ok",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "decidedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "decidedByName": {
      "type": [
        "string",
        "null"
      ]
    },
    "decisionNote": {
      "type": [
        "string",
        "null"
      ]
    },
    "appliedCommitSha": {
      "type": [
        "string",
        "null"
      ]
    },
    "selfApplied": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "teamId",
    "path",
    "op",
    "title",
    "note",
    "status",
    "authorId",
    "authorKind",
    "authorName",
    "baseBlobSha",
    "baseCommitSha",
    "diff",
    "added",
    "removed",
    "checks",
    "createdAt",
    "decidedAt",
    "decidedByName",
    "decisionNote",
    "appliedCommitSha",
    "selfApplied"
  ],
  "additionalProperties": false
}
