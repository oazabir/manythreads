{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "run"
    },
    "n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "label": {
      "type": "string",
      "maxLength": 200
    },
    "scope": {
      "type": "string",
      "enum": [
        "team",
        "channel",
        "person"
      ]
    },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "botId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "botSlug": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 63
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "kind",
    "n",
    "label",
    "scope",
    "runId",
    "botId",
    "botSlug"
  ],
  "additionalProperties": false
}
