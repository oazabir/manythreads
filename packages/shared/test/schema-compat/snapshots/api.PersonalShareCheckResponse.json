{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "allow",
        "redact",
        "require_approval",
        "block"
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "outcome",
    "rules"
  ]
}
