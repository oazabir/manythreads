{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "body": {
      "type": "string",
      "maxLength": 200
    },
    "tag": {
      "type": "string",
      "maxLength": 80
    },
    "url": {
      "type": "string",
      "maxLength": 300
    },
    "notificationId": {
      "type": "string",
      "maxLength": 80
    }
  },
  "required": [
    "v",
    "title",
    "body",
    "tag",
    "url",
    "notificationId"
  ]
}
