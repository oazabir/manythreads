{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "replay": {
      "type": "object",
      "properties": {
        "days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "since": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "model": {
          "type": "string",
          "const": "none"
        },
        "runs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "runsCapped": {
          "type": "boolean"
        },
        "counts": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "same": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "tighter": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "looser": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "notReplayed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "total",
            "same",
            "tighter",
            "looser",
            "notReplayed"
          ]
        },
        "byKind": {
          "type": "object",
          "properties": {
            "gate": {
              "type": "object",
              "properties": {
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "same": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "tighter": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "looser": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "notReplayed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "total",
                "same",
                "tighter",
                "looser",
                "notReplayed"
              ]
            },
            "guard": {
              "type": "object",
              "properties": {
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "same": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "tighter": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "looser": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "notReplayed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "total",
                "same",
                "tighter",
                "looser",
                "notReplayed"
              ]
            },
            "tool": {
              "type": "object",
              "properties": {
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "same": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "tighter": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "looser": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "notReplayed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "total",
                "same",
                "tighter",
                "looser",
                "notReplayed"
              ]
            }
          },
          "required": [
            "gate",
            "guard",
            "tool"
          ]
        },
        "changes": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "runId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "gate",
                  "guard",
                  "tool"
                ]
              },
              "what": {
                "type": "string",
                "maxLength": 200
              },
              "recorded": {
                "type": "string",
                "enum": [
                  "allowed",
                  "redacted",
                  "waits_for_person",
                  "refused"
                ]
              },
              "now": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "allowed",
                      "redacted",
                      "waits_for_person",
                      "refused"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "same",
                  "tighter",
                  "looser",
                  "not_replayed"
                ]
              },
              "explanation": {
                "type": "string",
                "maxLength": 600
              }
            },
            "required": [
              "runId",
              "at",
              "kind",
              "what",
              "recorded",
              "now",
              "verdict",
              "explanation"
            ]
          }
        },
        "changesCapped": {
          "type": "boolean"
        },
        "decisionsCapped": {
          "type": "boolean"
        },
        "notes": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 400
          }
        },
        "fullReplayable": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "runId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "trigger": {
                "type": "string",
                "maxLength": 40
              },
              "hasMessage": {
                "type": "boolean"
              }
            },
            "required": [
              "runId",
              "at",
              "trigger",
              "hasMessage"
            ]
          }
        }
      },
      "required": [
        "days",
        "since",
        "model",
        "runs",
        "runsCapped",
        "counts",
        "byKind",
        "changes",
        "changesCapped",
        "decisionsCapped",
        "notes",
        "fullReplayable"
      ]
    }
  },
  "required": [
    "replay"
  ]
}
