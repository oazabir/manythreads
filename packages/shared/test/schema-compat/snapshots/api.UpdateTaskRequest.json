{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "verify",
        "waiting_on_person",
        "done"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ]
    },
    "blockerReason": {
      "type": "string",
      "maxLength": 500
    },
    "testedSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    }
  },
  "additionalProperties": false
}
