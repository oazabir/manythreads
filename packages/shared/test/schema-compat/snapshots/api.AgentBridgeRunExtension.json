{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "mcp": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "url",
        "token"
      ],
      "additionalProperties": false
    },
    "tools": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "model": {
      "type": "object",
      "properties": {
        "alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "additionalProperties": false
    },
    "budgetSeconds": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "maxTurns": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "bot",
    "runId",
    "mcp",
    "tools",
    "budgetSeconds",
    "maxTurns"
  ],
  "additionalProperties": false
}
