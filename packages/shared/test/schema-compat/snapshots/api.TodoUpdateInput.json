{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "const": "update"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,40}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "working",
        "done",
        "blocked"
      ]
    }
  },
  "required": [
    "action",
    "id",
    "status"
  ],
  "additionalProperties": false
}
