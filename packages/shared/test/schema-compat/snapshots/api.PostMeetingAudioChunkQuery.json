{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "clientSegId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "startMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000
    },
    "lang": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    }
  },
  "required": [
    "clientSegId",
    "startMs",
    "durationMs"
  ]
}
