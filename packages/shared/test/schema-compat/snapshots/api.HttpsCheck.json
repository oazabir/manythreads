{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "enum": [
        "public-url",
        "wildcard",
        "client-ip",
        "proxy-match"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "warn",
        "fail",
        "skipped"
      ]
    },
    "detail": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "status",
    "detail"
  ]
}
