{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "tool"
        },
        "stepId": {
          "type": "string",
          "maxLength": 200
        },
        "parentStepId": {
          "type": "string",
          "maxLength": 200
        },
        "stepKind": {
          "type": "string",
          "enum": [
            "read",
            "edit",
            "delete",
            "move",
            "search",
            "execute",
            "think",
            "fetch",
            "switch_mode",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 400
        },
        "paths": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          }
        }
      },
      "required": [
        "kind",
        "stepId",
        "stepKind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "tool_result"
        },
        "stepId": {
          "type": "string",
          "maxLength": 200
        },
        "ok": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "maxLength": 400
        },
        "paths": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        },
        "diff": {
          "type": "object",
          "properties": {
            "added": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "removed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "added",
            "removed"
          ]
        }
      },
      "required": [
        "kind",
        "stepId",
        "ok"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "agent"
        },
        "agentId": {
          "type": "string",
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": [
            "working",
            "done",
            "failed"
          ]
        },
        "steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "parentStepId": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "kind",
        "agentId",
        "name",
        "status",
        "steps"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "plan"
        },
        "entries": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "content": {
                "type": "string",
                "maxLength": 400
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "in_progress",
                  "completed"
                ]
              }
            },
            "required": [
              "content",
              "status"
            ]
          }
        }
      },
      "required": [
        "kind",
        "entries"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "thinking"
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "seconds"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "approval"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "asked",
            "approved",
            "denied",
            "ended"
          ]
        },
        "stepId": {
          "type": "string",
          "maxLength": 200
        },
        "stepKind": {
          "type": "string",
          "enum": [
            "read",
            "edit",
            "delete",
            "move",
            "search",
            "execute",
            "think",
            "fetch",
            "switch_mode",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 400
        },
        "paths": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "diff": {
          "type": "object",
          "properties": {
            "added": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "removed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "added",
            "removed"
          ]
        }
      },
      "required": [
        "kind",
        "outcome"
      ]
    }
  ]
}
