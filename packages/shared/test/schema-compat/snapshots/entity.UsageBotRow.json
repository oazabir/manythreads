{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "botId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "slug": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "teamId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "teamSlug": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "teamName": {
      "type": [
        "string",
        "null"
      ]
    },
    "runs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "failedRuns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "toolCalls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "answers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "spendUsd": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "errorRate": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "botId",
    "slug",
    "name",
    "teamId",
    "teamSlug",
    "teamName",
    "runs",
    "failedRuns",
    "toolCalls",
    "answers",
    "spendUsd",
    "errorRate"
  ],
  "additionalProperties": false
}
