{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "standard",
        "strict-egress",
        "air-gapped",
        "customer-facing"
      ]
    },
    "egressAllowlist": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      }
    },
    "caching": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
