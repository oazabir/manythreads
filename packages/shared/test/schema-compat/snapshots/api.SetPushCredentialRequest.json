{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,254})$"
    },
    "token": {
      "type": "string",
      "minLength": 20,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_\\-.]+$"
    },
    "shareWithOwner": {
      "type": "boolean"
    }
  },
  "required": [
    "username",
    "token"
  ],
  "additionalProperties": false
}
