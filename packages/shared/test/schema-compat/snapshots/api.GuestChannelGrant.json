{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "teamSlug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "channel": {
      "type": "string",
      "pattern": "^#[a-z0-9][a-z0-9-]{0,62}$"
    }
  },
  "required": [
    "teamSlug",
    "channel"
  ],
  "additionalProperties": false
}
