{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "people": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "matched": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "placeholders": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "withoutEmail": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "matchedNotOnTeam": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "total",
        "matched",
        "placeholders",
        "withoutEmail",
        "matchedNotOnTeam"
      ]
    },
    "channels": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "public": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "private": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "direct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "imported": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "total",
        "public",
        "private",
        "direct",
        "imported",
        "skipped"
      ]
    },
    "messages": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "imported": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "alreadyImported": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "threads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "replies": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reactions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mentions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "total",
        "imported",
        "alreadyImported",
        "threads",
        "replies",
        "reactions",
        "mentions"
      ]
    },
    "files": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inArchive": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "notInArchive": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "total",
        "inArchive",
        "notInArchive"
      ]
    },
    "skipped": {
      "maxItems": 15,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "app_message",
              "huddle",
              "canvas",
              "system_message",
              "empty_message",
              "channel_without_members",
              "dm_not_matched",
              "private_channel_unknown_members",
              "malformed_entry",
              "refused_entry",
              "line_too_long",
              "orphan_reply",
              "file_not_in_export",
              "message_shortened",
              "reaction_unknown_person"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "reason",
          "count"
        ]
      }
    },
    "channelLines": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "public",
              "private",
              "direct"
            ]
          },
          "messages": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "outcome": {
            "type": "string",
            "enum": [
              "create",
              "exists",
              "skip"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "app_message",
                  "huddle",
                  "canvas",
                  "system_message",
                  "empty_message",
                  "channel_without_members",
                  "dm_not_matched",
                  "private_channel_unknown_members",
                  "malformed_entry",
                  "refused_entry",
                  "line_too_long",
                  "orphan_reply",
                  "file_not_in_export",
                  "message_shortened",
                  "reaction_unknown_person"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "becomes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "kind",
          "messages",
          "outcome",
          "reason",
          "becomes"
        ]
      }
    },
    "lines": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      }
    }
  },
  "required": [
    "people",
    "channels",
    "messages",
    "files",
    "skipped",
    "channelLines",
    "lines"
  ]
}
