{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
    },
    "ready": {
      "type": "boolean"
    },
    "architecture": {
      "type": [
        "string",
        "null"
      ]
    },
    "cpuAllocatableMillis": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "memoryAllocatableBytes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "hasWorkVolume": {
      "type": "boolean"
    },
    "workVolumes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "name",
    "ready",
    "architecture",
    "cpuAllocatableMillis",
    "memoryAllocatableBytes",
    "hasWorkVolume",
    "workVolumes"
  ],
  "additionalProperties": false
}
