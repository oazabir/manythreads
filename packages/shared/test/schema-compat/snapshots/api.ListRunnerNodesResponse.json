{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "available": {
      "type": "boolean"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
          },
          "ready": {
            "type": "boolean"
          },
          "architecture": {
            "type": [
              "string",
              "null"
            ]
          },
          "cpuAllocatableMillis": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "memoryAllocatableBytes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "hasWorkVolume": {
            "type": "boolean"
          },
          "workVolumes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "ready",
          "architecture",
          "cpuAllocatableMillis",
          "memoryAllocatableBytes",
          "hasWorkVolume",
          "workVolumes"
        ]
      }
    },
    "singleNode": {
      "type": "boolean"
    },
    "placement": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "idle",
                "running",
                "waiting",
                "moving"
              ]
            },
            "node": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "node_not_ready",
                    "not_placed",
                    "starting",
                    "move_not_confirmed"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "state",
            "node",
            "reason"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "available",
    "nodes",
    "singleNode",
    "placement",
    "note"
  ]
}
