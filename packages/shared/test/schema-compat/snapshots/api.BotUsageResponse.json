{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "range": {
      "type": "object",
      "properties": {
        "days": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "since": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "until": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "days",
        "since",
        "until"
      ]
    },
    "totals": {
      "type": "object",
      "properties": {
        "runs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failedRuns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stoppedRuns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "toolCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "toolsRefused": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "toolsHeldForApproval": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "approvalsAsked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "approvalsApproved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "approvalsDenied": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "approvalWaitSeconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "answers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "answersScoped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "answersFull": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "knowledgeHits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "llmCalls": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "spendUsd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "runs",
        "failedRuns",
        "stoppedRuns",
        "toolCalls",
        "toolsRefused",
        "toolsHeldForApproval",
        "approvalsAsked",
        "approvalsApproved",
        "approvalsDenied",
        "approvalWaitSeconds",
        "answers",
        "answersScoped",
        "answersFull",
        "knowledgeHits",
        "llmCalls",
        "tokens",
        "spendUsd"
      ]
    },
    "daily": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "runs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "failedRuns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "toolCalls": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "answers": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "spendUsd": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "day",
          "runs",
          "failedRuns",
          "toolCalls",
          "answers",
          "spendUsd"
        ]
      }
    },
    "spendByAlias": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string"
          },
          "spendUsd": {
            "type": "number",
            "minimum": 0
          },
          "calls": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "alias",
          "spendUsd",
          "calls"
        ]
      }
    },
    "quality": {
      "type": "object",
      "properties": {
        "answers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scoped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "full": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "citations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dropped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sourcesReached": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "knowledgeHits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "citationsPerAnswer": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "droppedShare": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "answers",
        "scoped",
        "full",
        "citations",
        "dropped",
        "sourcesReached",
        "knowledgeHits",
        "citationsPerAnswer",
        "droppedShare"
      ]
    },
    "budget": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "enum": [
                "workspace",
                "team",
                "bot"
              ]
            },
            "window": {
              "type": "string",
              "enum": [
                "day",
                "month"
              ]
            },
            "limitUsd": {
              "type": "number",
              "minimum": 0
            },
            "spentUsd": {
              "type": "number",
              "minimum": 0
            },
            "since": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "scope",
            "window",
            "limitUsd",
            "spentUsd",
            "since"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "team": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "slug",
        "name"
      ]
    },
    "bot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "slug": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "slug",
        "name"
      ]
    }
  },
  "required": [
    "range",
    "totals",
    "daily",
    "spendByAlias",
    "quality",
    "budget",
    "generatedAt",
    "team",
    "bot"
  ]
}
