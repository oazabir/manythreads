{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "recipeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    }
  },
  "required": [
    "slug",
    "recipeId"
  ]
}
