{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "clientId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "clientSecret": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "tenant": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,62}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "clientId",
    "clientSecret"
  ],
  "additionalProperties": false
}
