{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "member",
        "guest"
      ]
    },
    "channels": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "teamSlug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "channel": {
            "type": "string",
            "pattern": "^#[a-z0-9][a-z0-9-]{0,62}$"
          },
          "permission": {
            "type": "string",
            "enum": [
              "read",
              "post"
            ]
          }
        },
        "required": [
          "teamSlug",
          "channel"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "email",
    "role"
  ],
  "additionalProperties": false
}
