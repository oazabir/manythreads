{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "identity.session.sign_in_failed"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "workspaceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "personId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "method": {
      "type": "string",
      "const": "password"
    },
    "reason": {
      "type": "string",
      "enum": [
        "wrong_password",
        "locked",
        "suspended",
        "method_disabled"
      ]
    },
    "ip": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "type",
    "schemaVersion",
    "workspaceId",
    "personId",
    "method",
    "reason",
    "ip"
  ],
  "additionalProperties": false
}
