{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "allow",
        "redact",
        "require_approval",
        "block"
      ]
    },
    "text": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "rule",
          "count"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "outcome",
    "text",
    "findings"
  ],
  "additionalProperties": false
}
