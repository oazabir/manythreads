{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "path": {
      "type": "string"
    },
    "folder": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "repo",
            "attachment"
          ]
        },
        "readOnly": {
          "type": "boolean"
        },
        "readOnlyReason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "change_by_pull_request",
                "attachment",
                "no_write_access"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "managedBy": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "team_memory"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "channelId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "source",
        "readOnly",
        "readOnlyReason",
        "managedBy",
        "channelId"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "folder"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "mime": {
            "type": [
              "string",
              "null"
            ]
          },
          "updatedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "updatedBy": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "repo",
              "attachment"
            ]
          },
          "readOnly": {
            "type": "boolean"
          },
          "readOnlyReason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "change_by_pull_request",
                  "attachment",
                  "no_write_access"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "managedBy": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "team_memory"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "fileId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "channelId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "blobSha": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "contentUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "path",
          "name",
          "size",
          "mime",
          "updatedAt",
          "updatedBy",
          "source",
          "readOnly",
          "readOnlyReason",
          "managedBy",
          "fileId",
          "channelId",
          "blobSha",
          "contentUrl"
        ]
      }
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "path",
    "folder",
    "entries",
    "truncated"
  ]
}
