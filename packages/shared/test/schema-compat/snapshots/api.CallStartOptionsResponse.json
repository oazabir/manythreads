{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "canStart": {
      "type": "boolean"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "directMessage": {
      "type": "boolean"
    },
    "defaultTitle": {
      "type": "string"
    },
    "live": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "meetingId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "meetingId",
            "title"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "people": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "personId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "displayName": {
            "type": "string"
          },
          "you": {
            "type": "boolean"
          }
        },
        "required": [
          "personId",
          "displayName",
          "you"
        ]
      }
    },
    "peopleTotal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "notetaker": {
      "type": "object",
      "properties": {
        "bots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "botId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "slug": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "avatar": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(preset:[a-z0-9-]{1,40}|photo:[0-9a-f]{16})$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "botId",
              "slug",
              "name",
              "role"
            ]
          }
        },
        "defaultBotId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "bots",
        "defaultBotId",
        "available",
        "reason"
      ]
    },
    "guestLinks": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean",
          "const": false
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "available",
        "reason"
      ]
    }
  },
  "required": [
    "canStart",
    "reason",
    "directMessage",
    "defaultTitle",
    "live",
    "people",
    "peopleTotal",
    "notetaker",
    "guestLinks"
  ]
}
