{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "google",
              "microsoft",
              "notion"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "configured": {
            "type": "boolean"
          },
          "connected": {
            "type": "boolean"
          },
          "state": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "ok",
                  "needs_reconnect"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "accountLabel": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "redirectUri": {
            "type": "string",
            "maxLength": 500
          },
          "services": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,31}$"
                },
                "label": {
                  "type": "string",
                  "maxLength": 80
                },
                "description": {
                  "type": "string",
                  "maxLength": 300
                },
                "tools": {
                  "maxItems": 16,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 80
                  }
                },
                "writes": {
                  "type": "boolean"
                },
                "granted": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "label",
                "description",
                "tools",
                "writes",
                "granted"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "label",
          "configured",
          "connected",
          "state",
          "accountLabel",
          "redirectUri",
          "services"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "providers"
  ],
  "additionalProperties": false
}
