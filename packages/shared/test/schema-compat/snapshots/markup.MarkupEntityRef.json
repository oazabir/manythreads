{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "thread",
        "file",
        "page",
        "task"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "start": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "end": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "type",
    "id",
    "start",
    "end"
  ],
  "additionalProperties": false
}
