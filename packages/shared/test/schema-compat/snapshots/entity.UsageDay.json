{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "runs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "failedRuns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "toolCalls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "answers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "spendUsd": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "day",
    "runs",
    "failedRuns",
    "toolCalls",
    "answers",
    "spendUsd"
  ],
  "additionalProperties": false
}
