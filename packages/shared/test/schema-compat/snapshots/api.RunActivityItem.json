{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tool"
            },
            "stepId": {
              "type": "string",
              "maxLength": 200
            },
            "parentStepId": {
              "type": "string",
              "maxLength": 200
            },
            "stepKind": {
              "type": "string",
              "enum": [
                "read",
                "edit",
                "delete",
                "move",
                "search",
                "execute",
                "think",
                "fetch",
                "switch_mode",
                "other"
              ]
            },
            "title": {
              "type": "string",
              "maxLength": 400
            },
            "paths": {
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 300
              }
            }
          },
          "required": [
            "kind",
            "stepId",
            "stepKind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tool_result"
            },
            "stepId": {
              "type": "string",
              "maxLength": 200
            },
            "ok": {
              "type": "boolean"
            },
            "title": {
              "type": "string",
              "maxLength": 400
            },
            "paths": {
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 300
              }
            },
            "seconds": {
              "type": "number",
              "minimum": 0
            },
            "diff": {
              "type": "object",
              "properties": {
                "added": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "removed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "added",
                "removed"
              ]
            }
          },
          "required": [
            "kind",
            "stepId",
            "ok"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "agent"
            },
            "agentId": {
              "type": "string",
              "maxLength": 200
            },
            "name": {
              "type": "string",
              "maxLength": 200
            },
            "status": {
              "type": "string",
              "enum": [
                "working",
                "done",
                "failed"
              ]
            },
            "steps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "parentStepId": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "kind",
            "agentId",
            "name",
            "status",
            "steps"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plan"
            },
            "entries": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "maxLength": 400
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "pending",
                      "in_progress",
                      "completed"
                    ]
                  }
                },
                "required": [
                  "content",
                  "status"
                ]
              }
            }
          },
          "required": [
            "kind",
            "entries"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "thinking"
            },
            "seconds": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "seconds"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "approval"
            },
            "outcome": {
              "type": "string",
              "enum": [
                "asked",
                "approved",
                "denied",
                "ended"
              ]
            },
            "stepId": {
              "type": "string",
              "maxLength": 200
            },
            "stepKind": {
              "type": "string",
              "enum": [
                "read",
                "edit",
                "delete",
                "move",
                "search",
                "execute",
                "think",
                "fetch",
                "switch_mode",
                "other"
              ]
            },
            "title": {
              "type": "string",
              "maxLength": 400
            },
            "paths": {
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 300
              }
            },
            "diff": {
              "type": "object",
              "properties": {
                "added": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "removed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "added",
                "removed"
              ]
            }
          },
          "required": [
            "kind",
            "outcome"
          ]
        }
      ]
    }
  },
  "required": [
    "seq",
    "at",
    "payload"
  ]
}
