{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "bots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    },
    "dot": {
      "type": "string",
      "enum": [
        "done",
        "running",
        "todo",
        "blocked"
      ]
    },
    "rework": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "title",
    "bots",
    "status",
    "dot",
    "rework"
  ]
}
