{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "frontmatter": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "tags": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "stable",
            "deprecated"
          ]
        },
        "stale_after": {
          "type": "string",
          "maxLength": 64
        },
        "sources": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              {
                "type": "object",
                "properties": {
                  "resource": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "author": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "usage_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "last_modified": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "usage_window": {
                    "type": "object",
                    "properties": {
                      "from": {
                        "type": "string",
                        "maxLength": 64
                      },
                      "to": {
                        "type": "string",
                        "maxLength": 64
                      }
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "resource"
                ],
                "additionalProperties": {}
              }
            ]
          }
        },
        "usage_window": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "maxLength": 64
            },
            "to": {
              "type": "string",
              "maxLength": 64
            }
          },
          "additionalProperties": {}
        },
        "generated": {
          "type": "object",
          "properties": {
            "by": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "at": {
              "type": "string",
              "maxLength": 64
            }
          },
          "required": [
            "by"
          ],
          "additionalProperties": {}
        },
        "verified": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "by": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "at": {
                "type": "string",
                "maxLength": 64
              }
            },
            "required": [
              "by"
            ],
            "additionalProperties": {}
          }
        },
        "origin": {
          "type": "string",
          "maxLength": 64
        },
        "share": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": {}
    },
    "body": {
      "type": "string"
    },
    "trustTier": {
      "type": "string",
      "enum": [
        "unverified",
        "machine-confirmed",
        "human-reviewed"
      ]
    },
    "stale": {
      "type": "boolean"
    },
    "deprecated": {
      "type": "boolean"
    }
  },
  "required": [
    "path",
    "frontmatter",
    "body",
    "trustTier",
    "stale",
    "deprecated"
  ],
  "additionalProperties": false
}
