{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "promptTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "completionTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "costUsd": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "priceKnown": {
      "type": "boolean"
    },
    "maxCalls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "basis": {
      "type": "string",
      "maxLength": 400
    },
    "confirmToken": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    }
  },
  "required": [
    "runId",
    "calls",
    "promptTokens",
    "completionTokens",
    "tokens",
    "costUsd",
    "priceKnown",
    "maxCalls",
    "basis",
    "confirmToken"
  ],
  "additionalProperties": false
}
