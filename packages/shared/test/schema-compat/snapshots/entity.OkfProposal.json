{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "title": {
      "type": "string",
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "tags": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "stable",
        "deprecated"
      ]
    },
    "staleAfter": {
      "type": "string",
      "maxLength": 64
    },
    "resource": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "body": {
      "type": "string",
      "maxLength": 200000
    }
  },
  "required": [
    "path"
  ],
  "additionalProperties": false
}
