{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "minLength": 8,
      "maxLength": 2048
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "syncMinutes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 15,
          "maximum": 10080
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "url"
  ],
  "additionalProperties": false
}
