{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "agent": {
      "type": "string",
      "enum": [
        "claude-code",
        "codex",
        "hermes-acp"
      ]
    },
    "version": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "agent",
    "version"
  ],
  "additionalProperties": false
}
