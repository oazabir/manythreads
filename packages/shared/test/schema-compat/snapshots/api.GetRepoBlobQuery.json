{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "ref": {
      "default": "main",
      "type": "string",
      "pattern": "^(HEAD|main|[0-9a-f]{7,40})$"
    }
  },
  "required": [
    "path"
  ]
}
