{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "put"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "content": {
          "type": "string",
          "maxLength": 2000000
        },
        "encoding": {
          "default": "utf8",
          "type": "string",
          "enum": [
            "utf8",
            "base64"
          ]
        },
        "baseBlobSha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "op",
        "path",
        "content"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "append"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "content": {
          "type": "string",
          "maxLength": 2000000
        },
        "encoding": {
          "default": "utf8",
          "type": "string",
          "enum": [
            "utf8",
            "base64"
          ]
        }
      },
      "required": [
        "op",
        "path",
        "content"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "delete"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "baseBlobSha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "op",
        "path"
      ],
      "additionalProperties": false
    }
  ]
}
