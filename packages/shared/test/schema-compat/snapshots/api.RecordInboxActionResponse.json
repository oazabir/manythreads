{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "action": {
      "type": "object",
      "properties": {
        "conceptPath": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "what": {
          "type": "string"
        },
        "ownerName": {
          "type": [
            "string",
            "null"
          ]
        },
        "ownerActorId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "due": {
          "type": [
            "string",
            "null"
          ]
        },
        "done": {
          "type": "boolean"
        },
        "prepared": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": {
              "type": "string",
              "maxLength": 4000
            },
            "kind": {
              "type": "string",
              "const": "other"
            },
            "priority": {
              "type": "string",
              "const": "normal"
            },
            "branch": {
              "type": "string",
              "const": "main"
            }
          },
          "required": [
            "title",
            "description",
            "kind",
            "priority",
            "branch"
          ]
        },
        "taskId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "addedBy": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "conceptPath",
        "index",
        "what",
        "ownerName",
        "ownerActorId",
        "due",
        "done",
        "prepared",
        "taskId",
        "addedBy"
      ]
    }
  },
  "required": [
    "action"
  ]
}
