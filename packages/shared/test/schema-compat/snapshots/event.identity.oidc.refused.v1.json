{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "identity.oidc.refused"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "workspaceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "providerId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "google",
        "microsoft",
        "oidc"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "domain_not_allowed",
        "tenant_not_allowed",
        "email_not_verified",
        "account_unverified",
        "identity_mismatch",
        "signup_closed",
        "account_suspended",
        "provider_disabled",
        "state_invalid",
        "token_invalid",
        "access_denied",
        "sign_in_failed"
      ]
    },
    "email": {
      "type": [
        "string",
        "null"
      ]
    },
    "ip": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "type",
    "schemaVersion",
    "workspaceId",
    "providerId",
    "kind",
    "reason",
    "email",
    "ip"
  ],
  "additionalProperties": false
}
