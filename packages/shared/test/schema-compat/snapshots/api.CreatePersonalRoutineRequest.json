{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "confirmed": {
      "type": "boolean",
      "const": true
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "words": {
      "default": "",
      "type": "string",
      "maxLength": 2000
    },
    "botSlug": {
      "default": "brain",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "schedule": {
      "type": "string",
      "pattern": "^\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s+\\S+$"
    },
    "scheduleWords": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "timeZone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z_]+(?:[/+-][A-Za-z0-9_+-]+)*$"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "sources": {
      "default": [],
      "maxItems": 11,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "mail",
          "calendar",
          "mentions",
          "threads",
          "approvals",
          "cards",
          "meetings",
          "notes",
          "memory",
          "knowledge",
          "action_items"
        ]
      }
    },
    "outputPath": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "outputMode": {
      "default": "replace",
      "type": "string",
      "enum": [
        "create",
        "replace",
        "append"
      ]
    },
    "recipeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    }
  },
  "required": [
    "confirmed",
    "name",
    "schedule",
    "scheduleWords",
    "timeZone",
    "prompt"
  ],
  "additionalProperties": false
}
