{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ref": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "chip": {
      "type": "string",
      "enum": [
        "planned",
        "running",
        "waiting for a person",
        "done",
        "stopped"
      ]
    },
    "spend": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "usd": {
              "type": "number",
              "minimum": 0
            },
            "budgetUsd": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "usd",
            "budgetUsd"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "steps": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "bots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          },
          "dot": {
            "type": "string",
            "enum": [
              "done",
              "running",
              "todo",
              "blocked"
            ]
          },
          "rework": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "title",
          "bots",
          "status",
          "dot",
          "rework"
        ]
      }
    },
    "stepNow": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stepCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "board": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "teamSlug": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
            },
            "boardId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "teamSlug",
            "boardId"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "thread": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "rootId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "replies": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "lastName": {
              "type": [
                "string",
                "null"
              ]
            },
            "lastAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "faces": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "rootId",
            "replies",
            "lastName",
            "lastAt",
            "faces"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "ref",
    "title",
    "chip",
    "spend",
    "steps",
    "stepNow",
    "stepCount",
    "board",
    "thread"
  ]
}
