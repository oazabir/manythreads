{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "read",
            "edit",
            "delete",
            "move",
            "search",
            "execute",
            "think",
            "fetch",
            "switch_mode",
            "other"
          ]
        },
        {
          "type": "string",
          "enum": [
            "thinking",
            "answering"
          ]
        }
      ]
    },
    "title": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 400
        },
        {
          "type": "null"
        }
      ]
    },
    "paths": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "helper": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999
    }
  },
  "required": [
    "kind",
    "title",
    "paths",
    "helper",
    "count"
  ]
}
