{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "status": {
      "type": "string",
      "enum": [
        "kept",
        "masked",
        "removed"
      ]
    },
    "label": {
      "type": "string",
      "maxLength": 200
    }
  },
  "required": [
    "n",
    "kind",
    "status",
    "label"
  ]
}
