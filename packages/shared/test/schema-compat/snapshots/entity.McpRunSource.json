{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sourceType": {
      "type": "string",
      "minLength": 1
    },
    "sourceRef": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "enum": [
        "team",
        "channel",
        "person"
      ]
    }
  },
  "required": [
    "sourceType",
    "sourceRef",
    "scope"
  ],
  "additionalProperties": false
}
