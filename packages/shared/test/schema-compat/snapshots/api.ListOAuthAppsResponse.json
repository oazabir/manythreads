{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "google",
              "microsoft",
              "notion",
              "jira",
              "linear",
              "githubissues",
              "asana",
              "zendesk",
              "intercom",
              "hubspot",
              "salesforce",
              "confluence",
              "dropbox",
              "box"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "redirectUri": {
            "type": "string",
            "maxLength": 500
          },
          "source": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "workspace",
                  "server"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "clientId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "tenant": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "supportsTenant": {
            "type": "boolean"
          },
          "tenantKind": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "directory",
                  "subdomain"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "hasSecret": {
            "type": "boolean"
          },
          "updatedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "provider",
          "label",
          "redirectUri",
          "source",
          "clientId",
          "tenant",
          "supportsTenant",
          "hasSecret",
          "updatedAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "apps"
  ],
  "additionalProperties": false
}
