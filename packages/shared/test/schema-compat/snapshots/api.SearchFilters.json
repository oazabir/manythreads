{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "text": {
      "type": "string"
    },
    "from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "in": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "has": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "file",
          "link"
        ]
      }
    },
    "is": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "thread"
        ]
      }
    },
    "before": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "after": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "text",
    "from",
    "in",
    "has",
    "is",
    "before",
    "after"
  ]
}
