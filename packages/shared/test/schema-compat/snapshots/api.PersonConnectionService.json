{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "label": {
      "type": "string",
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "tools": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "writes": {
      "type": "boolean"
    },
    "granted": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "label",
    "description",
    "tools",
    "writes",
    "granted"
  ],
  "additionalProperties": false
}
