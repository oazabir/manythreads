{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
    },
    "pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 190
    },
    "ignoreCase": {
      "type": "boolean"
    },
    "action": {
      "type": "string",
      "enum": [
        "preset",
        "redact",
        "require_approval",
        "block"
      ]
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
