{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "anyone": {
      "type": "boolean"
    },
    "domains": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 255
      }
    },
    "users": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 320
      }
    },
    "groups": {
      "type": "boolean"
    }
  },
  "required": [
    "anyone",
    "domains",
    "users",
    "groups"
  ],
  "additionalProperties": false
}
