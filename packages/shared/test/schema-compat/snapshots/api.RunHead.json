{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "starting",
        "working",
        "waiting",
        "stopping",
        "done",
        "failed",
        "stopped"
      ]
    },
    "now": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "read",
                    "edit",
                    "delete",
                    "move",
                    "search",
                    "execute",
                    "think",
                    "fetch",
                    "switch_mode",
                    "other"
                  ]
                },
                {
                  "type": "string",
                  "enum": [
                    "thinking",
                    "answering"
                  ]
                }
              ]
            },
            "title": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 400
                },
                {
                  "type": "null"
                }
              ]
            },
            "paths": {
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 300
              }
            },
            "helper": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999
            }
          },
          "required": [
            "kind",
            "title",
            "paths",
            "helper",
            "count"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "counts": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "commands": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "filesChanged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "added": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "removed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "helpers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "thinkingSeconds": {
          "type": "number",
          "minimum": 0
        },
        "omitted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "steps",
        "failed",
        "commands",
        "filesChanged",
        "added",
        "removed",
        "helpers",
        "thinkingSeconds",
        "omitted"
      ]
    },
    "plan": {
      "type": "object",
      "properties": {
        "done": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "current": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 400
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "done",
        "total",
        "current"
      ]
    },
    "planVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "helpers": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "working",
              "done",
              "failed"
            ]
          },
          "steps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "steps"
        ]
      }
    },
    "seq": {
      "type": "integer",
      "minimum": -1,
      "maximum": 9007199254740991
    },
    "stoppedBy": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "botId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "botActorId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "botName": {
      "type": "string",
      "maxLength": 200
    },
    "channelId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "threadRootId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "askerActorId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "conversation": {
      "type": "boolean"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "endedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stopReason": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 60
        },
        {
          "type": "null"
        }
      ]
    },
    "cost": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "maxLength": 8
            }
          },
          "required": [
            "amount",
            "currency"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "canStop": {
      "type": "boolean"
    }
  },
  "required": [
    "state",
    "now",
    "counts",
    "plan",
    "planVersion",
    "helpers",
    "seq",
    "stoppedBy",
    "runId",
    "botId",
    "botActorId",
    "botName",
    "channelId",
    "threadRootId",
    "askerActorId",
    "conversation",
    "startedAt",
    "endedAt",
    "stopReason",
    "cost",
    "canStop"
  ]
}
