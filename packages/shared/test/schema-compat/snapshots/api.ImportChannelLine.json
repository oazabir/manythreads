{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "kind": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "direct"
      ]
    },
    "messages": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "outcome": {
      "type": "string",
      "enum": [
        "create",
        "exists",
        "skip"
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "app_message",
            "huddle",
            "canvas",
            "system_message",
            "empty_message",
            "channel_without_members",
            "dm_not_matched",
            "private_channel_unknown_members",
            "malformed_entry",
            "refused_entry",
            "line_too_long",
            "orphan_reply",
            "file_not_in_export",
            "message_shortened",
            "reaction_unknown_person"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "becomes": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "name",
    "kind",
    "messages",
    "outcome",
    "reason",
    "becomes"
  ]
}
