{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "const": "waiting"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "audio",
        "video"
      ]
    }
  },
  "required": [
    "state",
    "title",
    "kind"
  ]
}
