{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "destination": {
      "type": "string",
      "enum": [
        "team_files",
        "team_inbox"
      ]
    },
    "teamSlug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63
    }
  },
  "required": [
    "destination",
    "teamSlug"
  ],
  "additionalProperties": false
}
