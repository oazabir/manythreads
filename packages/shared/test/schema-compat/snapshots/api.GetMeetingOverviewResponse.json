{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "meeting": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "workspaceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "teamId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "channelId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "state": {
          "type": "string",
          "enum": [
            "live",
            "ended"
          ]
        },
        "startedBy": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "organizerId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "notetakerBotId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "endedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "endReason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "person",
                "empty"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "transcription": {
          "type": "string",
          "enum": [
            "on_device",
            "server",
            "off"
          ]
        },
        "recording": {
          "type": "boolean"
        },
        "transcriptPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcriptFileId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "threadRootId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "workspaceId",
        "teamId",
        "channelId",
        "title",
        "state",
        "startedBy",
        "organizerId",
        "notetakerBotId",
        "startedAt",
        "endedAt",
        "endReason",
        "transcription",
        "recording",
        "transcriptPath",
        "transcriptFileId",
        "threadRootId"
      ]
    },
    "teamSlug": {
      "type": [
        "string",
        "null"
      ]
    },
    "channelName": {
      "type": [
        "string",
        "null"
      ]
    },
    "durationSeconds": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "organizerName": {
      "type": "string"
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actorId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "displayName": {
            "type": "string"
          },
          "transcribed": {
            "type": "boolean"
          }
        },
        "required": [
          "actorId",
          "displayName",
          "transcribed"
        ]
      }
    },
    "location": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "repo",
            "channel_files",
            "personal"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "transcriptPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "notesPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "notesStatus": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "pending",
            "written",
            "failed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "thread": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "channelId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "rootId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "channelId",
            "rootId"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "hasAudio": {
      "type": "boolean"
    },
    "notetaker": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "botId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "slug": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "avatar": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(preset:[a-z0-9-]{1,40}|photo:[0-9a-f]{16})$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "botId",
            "slug",
            "name",
            "role"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "decisionCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "actionItemCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "you": {
      "type": "object",
      "properties": {
        "isOrganizer": {
          "type": "boolean"
        },
        "canManage": {
          "type": "boolean"
        },
        "canReadNotes": {
          "type": "boolean"
        }
      },
      "required": [
        "isOrganizer",
        "canManage",
        "canReadNotes"
      ]
    }
  },
  "required": [
    "meeting",
    "teamSlug",
    "channelName",
    "durationSeconds",
    "organizerName",
    "people",
    "location",
    "transcriptPath",
    "notesPath",
    "notesStatus",
    "thread",
    "hasAudio",
    "notetaker",
    "decisionCount",
    "actionItemCount",
    "you"
  ]
}
