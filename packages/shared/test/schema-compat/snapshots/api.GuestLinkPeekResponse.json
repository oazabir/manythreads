{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "const": "open"
    },
    "workspaceName": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "audio",
        "video"
      ]
    },
    "transcribing": {
      "type": "boolean"
    },
    "notetaker": {
      "type": "boolean"
    }
  },
  "required": [
    "state",
    "workspaceName",
    "title",
    "kind",
    "transcribing",
    "notetaker"
  ]
}
