{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "speech",
        "answer"
      ]
    },
    "speakerId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "speakerName": {
      "type": "string",
      "maxLength": 200
    },
    "startMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "endMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "text": {
      "type": "string",
      "maxLength": 4000
    },
    "final": {
      "type": "boolean"
    },
    "catchingUp": {
      "default": false,
      "type": "boolean"
    },
    "askerName": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "kind",
    "speakerId",
    "speakerName",
    "startMs",
    "endMs",
    "text",
    "final",
    "catchingUp",
    "askerName"
  ],
  "additionalProperties": false
}
