{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "eventFilter": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_]*(\\.([a-z][a-z0-9_]*|\\*)){0,3}$"
      }
    }
  },
  "additionalProperties": false
}
