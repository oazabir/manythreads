{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "theme": {
      "type": "string",
      "enum": [
        "system",
        "light",
        "dark"
      ]
    },
    "density": {
      "type": "string",
      "enum": [
        "comfortable",
        "compact"
      ]
    }
  },
  "required": [
    "theme",
    "density"
  ],
  "additionalProperties": false
}
