{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "meetingId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "audio",
        "video"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "state": {
      "type": "string",
      "enum": [
        "live",
        "ended"
      ]
    },
    "startedBy": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "starterName": {
      "type": "string"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "endedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "durationSeconds": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "present": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actorId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "actorId",
          "displayName"
        ],
        "additionalProperties": false
      }
    },
    "presentCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "joinedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "invited": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "names": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "count",
        "names"
      ],
      "additionalProperties": false
    },
    "notetaker": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "listening": {
              "type": "boolean"
            }
          },
          "required": [
            "name",
            "listening"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "you": {
      "type": "object",
      "properties": {
        "joined": {
          "type": "boolean"
        },
        "canEnd": {
          "type": "boolean"
        },
        "canInvite": {
          "type": "boolean"
        }
      },
      "required": [
        "joined",
        "canEnd",
        "canInvite"
      ],
      "additionalProperties": false
    },
    "notesLink": {
      "type": [
        "string",
        "null"
      ]
    },
    "guests": {
      "default": {
        "on": false,
        "inCall": 0,
        "canLink": false,
        "canTurnOff": false,
        "links": 0
      },
      "type": "object",
      "properties": {
        "on": {
          "type": "boolean"
        },
        "inCall": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "canLink": {
          "type": "boolean"
        },
        "canTurnOff": {
          "type": "boolean"
        },
        "links": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "on",
        "inCall",
        "canLink",
        "canTurnOff",
        "links"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "meetingId",
    "kind",
    "title",
    "state",
    "startedBy",
    "starterName",
    "startedAt",
    "endedAt",
    "durationSeconds",
    "present",
    "presentCount",
    "joinedCount",
    "invited",
    "notetaker",
    "you",
    "notesLink",
    "guests"
  ],
  "additionalProperties": false
}
