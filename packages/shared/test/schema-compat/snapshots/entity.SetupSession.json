{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "teamId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "status": {
      "type": "string",
      "enum": [
        "working",
        "asking",
        "proposed",
        "failed",
        "cancelled"
      ]
    },
    "brief": {
      "type": "string"
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "kind": {
            "type": "string",
            "enum": [
              "capability",
              "runtime",
              "connection",
              "knowledge",
              "skill",
              "runner",
              "trigger",
              "model",
              "other"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "grade": {
            "type": "string",
            "enum": [
              "covered",
              "grantable",
              "missing",
              "blocked",
              "unclear"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "id",
          "text",
          "kind",
          "grade",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^q[0-9]{1,3}$"
          },
          "requirementId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
          },
          "question": {
            "type": "string",
            "maxLength": 400
          },
          "options": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 80
            }
          }
        },
        "required": [
          "id",
          "requirementId",
          "question",
          "options"
        ],
        "additionalProperties": false
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string"
          },
          "requirementId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
          },
          "question": {
            "type": "string",
            "maxLength": 400
          },
          "answer": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "questionId",
          "requirementId",
          "question",
          "answer"
        ],
        "additionalProperties": false
      }
    },
    "inventory": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "team": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "slug",
                "name"
              ],
              "additionalProperties": false
            },
            "asker": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "member",
                    "lead",
                    "admin"
                  ]
                },
                "canGrantDestructive": {
                  "type": "boolean"
                },
                "canAddBot": {
                  "type": "boolean"
                }
              },
              "required": [
                "role",
                "canGrantDestructive",
                "canAddBot"
              ],
              "additionalProperties": false
            },
            "bots": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slug": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "runtime": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  }
                },
                "required": [
                  "slug",
                  "name",
                  "role",
                  "kind",
                  "runtime",
                  "status"
                ],
                "additionalProperties": false
              }
            },
            "knowledge": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slug": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "slug",
                  "name"
                ],
                "additionalProperties": false
              }
            },
            "skills": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slug": {
                    "type": "string"
                  }
                },
                "required": [
                  "slug"
                ],
                "additionalProperties": false
              }
            },
            "runners": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "isDefault": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "label",
                  "kind",
                  "status",
                  "isDefault"
                ],
                "additionalProperties": false
              }
            },
            "models": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "alias": {
                    "type": "string"
                  }
                },
                "required": [
                  "alias"
                ],
                "additionalProperties": false
              }
            },
            "channels": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            },
            "roleTags": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "capabilities": {
              "maxItems": 300,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "destructive": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "destructive"
                ],
                "additionalProperties": false
              }
            },
            "triggers": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "available": {
                    "type": "boolean"
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "available"
                ],
                "additionalProperties": false
              }
            },
            "runtimeAllowed": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "guardDefault": {
              "type": "string"
            },
            "connections": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "tools": {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "name",
                  "tools"
                ],
                "additionalProperties": false
              }
            },
            "connectionsNote": {
              "type": "string"
            }
          },
          "required": [
            "team",
            "asker",
            "bots",
            "knowledge",
            "skills",
            "runners",
            "models",
            "channels",
            "roleTags",
            "capabilities",
            "triggers",
            "runtimeAllowed",
            "guardDefault",
            "connections",
            "connectionsNote"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "proposalId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "bot",
              "skill",
              "team"
            ]
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "proposalId",
          "path",
          "role",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 400
      }
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "rounds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "id",
    "teamId",
    "status",
    "brief",
    "name",
    "requirements",
    "questions",
    "answers",
    "inventory",
    "proposals",
    "limits",
    "message",
    "rounds",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
