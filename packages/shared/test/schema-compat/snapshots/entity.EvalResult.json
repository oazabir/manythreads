{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "caseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "passed": {
      "type": "boolean"
    },
    "judged": {
      "type": "boolean"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasons": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 400
      }
    },
    "skipped": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40
      }
    },
    "answerExcerpt": {
      "type": "string",
      "maxLength": 400
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "costTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "caseId",
    "passed",
    "judged",
    "score",
    "reasons",
    "skipped",
    "answerExcerpt",
    "durationMs",
    "costTokens"
  ],
  "additionalProperties": false
}
