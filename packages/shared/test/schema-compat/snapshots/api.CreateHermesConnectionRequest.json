{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
    },
    "baseUrl": {
      "type": "string",
      "maxLength": 500,
      "format": "uri"
    },
    "apiKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 500
    }
  },
  "required": [
    "name",
    "baseUrl",
    "apiKey"
  ],
  "additionalProperties": false
}
