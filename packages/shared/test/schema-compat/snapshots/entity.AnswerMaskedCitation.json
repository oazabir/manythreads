{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "masked"
    },
    "n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    }
  },
  "required": [
    "kind",
    "n",
    "source"
  ],
  "additionalProperties": false
}
