{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "shareId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "counts": {
      "type": "object",
      "properties": {
        "matched": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "included": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "leftOut": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "retired": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "redacted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "matched",
        "included",
        "leftOut",
        "unchanged",
        "retired",
        "redacted"
      ],
      "additionalProperties": false
    },
    "headline": {
      "type": "string"
    },
    "included": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "title": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "path",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "title": {
            "type": "string",
            "maxLength": 500
          },
          "reason": {
            "type": "string",
            "enum": [
              "received",
              "original",
              "personal",
              "draft",
              "deprecated",
              "team_only",
              "trust",
              "stale",
              "unreadable",
              "dlp",
              "too_large"
            ]
          }
        },
        "required": [
          "path",
          "title",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "diff": {
      "type": "object",
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "title": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "path",
              "title"
            ],
            "additionalProperties": false
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "title": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "path",
              "title"
            ],
            "additionalProperties": false
          }
        },
        "retired": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "title": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "path",
              "title"
            ],
            "additionalProperties": false
          }
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "added",
        "changed",
        "retired",
        "unchanged"
      ],
      "additionalProperties": false
    },
    "destinations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "teamId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "link": {
            "type": "string",
            "enum": [
              "requested",
              "accepted",
              "paused",
              "revoked"
            ]
          }
        },
        "required": [
          "teamId",
          "slug",
          "name",
          "link"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "shareId",
    "counts",
    "headline",
    "included",
    "excluded",
    "diff",
    "destinations"
  ],
  "additionalProperties": false
}
