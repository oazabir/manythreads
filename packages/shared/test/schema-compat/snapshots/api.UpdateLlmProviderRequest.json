{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "apiKey": {
      "type": "string"
    },
    "apiBase": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 300,
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "apiVersion": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        {
          "type": "null"
        }
      ]
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
