{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "enum": [
        "google",
        "microsoft",
        "notion"
      ]
    },
    "label": {
      "type": "string",
      "maxLength": 80
    },
    "configured": {
      "type": "boolean"
    },
    "problem": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "unavailable",
            "rejected"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "refreshedAt": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "connected": {
      "type": "boolean"
    },
    "state": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "ok",
            "needs_reconnect"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "accountLabel": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "redirectUri": {
      "type": "string",
      "maxLength": 500
    },
    "services": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "maxLength": 300
          },
          "tools": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 80
            }
          },
          "writes": {
            "type": "boolean"
          },
          "granted": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "description",
          "tools",
          "writes",
          "granted"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "label",
    "configured",
    "connected",
    "state",
    "accountLabel",
    "redirectUri",
    "services"
  ],
  "additionalProperties": false
}
