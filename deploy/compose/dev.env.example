# Environment for running the manythreads server against the dev compose stack (copy to .env next to the compose file, or
# export the variables). The Helm chart (deploy/helm/manythreads) sets the same ones in the cluster.

# Master key of the envelope-encryption KMS: base64 of exactly 32 random bytes (provider client secrets are encrypted
# under it; losing it loses them). Required when NODE_ENV=production (the server image); dev runs fall back to a public key.
#   openssl rand -base64 32
MANYTHREADS_KMS_KEY=

# Public base URL: links in mails and the OIDC redirect URI (<url>/api/auth/oidc/callback). Secure cookies follow it.
MANYTHREADS_PUBLIC_URL=http://localhost:3000

# Reverse-proxy hops in front of the server that append to X-Forwarded-For (0 = none, as here; the cluster uses 2).
MANYTHREADS_TRUST_PROXY=0

# Mail: mailpit from this compose file (SMTP 1025; the web UI is on http://localhost:8025).
MANYTHREADS_SMTP_URL=smtp://localhost:1025
MANYTHREADS_MAIL_FROM="manythreads <no-reply@localhost>"

# Mock OIDC (the `oidc` service, tools/mock-oidc): Google and Microsoft presets talk to http://localhost:8080/<google|microsoft>.
MANYTHREADS_OIDC_MOCK_BASE=http://localhost:8080

# Seed the Kahf Software world into the dev database (idempotent): `pnpm seed` (shared test password) or `pnpm seed --demo`.
# MANYTHREADS_TEST_AUTH_TOKEN (>= 16 characters) mounts POST /api/test/session for e2e and screenshots; test environments only.
