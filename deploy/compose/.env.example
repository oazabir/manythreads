# The settings of the Docker Compose install (docs/deploy/compose.md). Do not fill this file by hand: `sh deploy/compose/make-env.sh` writes a `.env`
# next to the compose file with every password and key generated. This copy only names them.
#
# Every value below that says "generated" must be set before `docker compose up`; the compose file refuses to start without it, and nothing in the
# repository or the images has a default for any of them.

# The address people open in the browser, no trailing slash. Cookies, links in mails and the MCP address are built from it.
MANYTHREADS_PUBLIC_URL=http://localhost:3000
# Where the web port is published. 127.0.0.1 = this machine only (put a reverse proxy in front); 0.0.0.0 = every interface.
# MANYTHREADS_BIND=127.0.0.1
# MANYTHREADS_PORT=3000
# 1 when a reverse proxy in front sets X-Forwarded-For (then the client address in logs and rate limits is the real one).
# MANYTHREADS_TRUST_PROXY=0
# Mail (invitations, password resets). Empty = mail is not sent and the server says so in its log.
# MANYTHREADS_SMTP_URL=smtp://user:password@smtp.example.org:587
# MANYTHREADS_MAIL_FROM=manythreads <no-reply@example.org>

# generated: the database owner's password (the owner makes the roles and runs the migrations)
POSTGRES_PASSWORD=
# generated: the passwords of the two roles the application connects as
MANYTHREADS_APP_PASSWORD=
MANYTHREADS_SYSTEM_PASSWORD=
# generated: base64 of 32 random bytes; encrypts every stored secret. Keep a copy somewhere else.
MANYTHREADS_KMS_KEY=
# generated: the model gateway's master key and salt (keys start with sk-)
MANYTHREADS_LITELLM_MASTER_KEY=
MANYTHREADS_LITELLM_SALT_KEY=
# generated: team memory (Hindsight): the key the server uses, the engine's database password, and its model key (limited to the alias `fast`)
MANYTHREADS_HINDSIGHT_API_KEY=
MANYTHREADS_HINDSIGHT_DB_PASSWORD=
MANYTHREADS_HINDSIGHT_LLM_KEY=
# generated: the Hermes container's key (the runner's key and every profile's) and the model key its profiles use (starts with sk-)
MANYTHREADS_HERMES_API_KEY=
MANYTHREADS_HERMES_LLM_KEY=

# Optional: pin the Hindsight image (default 0.10.3).
# MANYTHREADS_HINDSIGHT_TAG=0.10.3
