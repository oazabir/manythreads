!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!.nvmrc
!packages
!clients
!avatars
!templates
!deploy/docker/nginx.conf
**/node_modules
**/dist
# a developer's own `pnpm models:fetch` output: the image fetches (and checks) its own copy in the `models` stage
clients/web/public/models
